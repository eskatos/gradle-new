    "options": [
        {
            "name": "comments",
            "description": "Include clarifying comments in files.",
            "negatedDescription": "Disables option --comments."
        },
        {
            "name": "dsl",
            "description": "Set the build script DSL to be used in generated scripts.",
            "negatedDescription": null
        },
        {
            "name": "incubating",
            "description": "Allow the generated build to use new features and APIs.",
            "negatedDescription": "Disables option --incubating."
        },
        {
            "name": "insecure-protocol",
            "description": "How to handle insecure URLs used for Maven Repositories.",
            "negatedDescription": null
        },
        {
            "name": "java-version",
            "description": "Provides java version to use in the project.",
            "negatedDescription": null
        },
        {
            "name": "overwrite",
            "description": "Allow existing files in the build directory to be overwritten?",
            "negatedDescription": "Disables option --overwrite."
        },
        {
            "name": "package",
            "description": "Set the package for source files.",
            "negatedDescription": null
        },
        {
            "name": "project-name",
            "description": "Set the project name.",
            "negatedDescription": null
        },
        {
            "name": "split-project",
            "description": "Split functionality across multiple subprojects?",
            "negatedDescription": "Disables option --split-project."
        },
        {
            "name": "test-framework",
            "description": "Set the test framework to be used.",
            "negatedDescription": null
        },
        {
            "name": "type",
            "description": "Set the type of project to generate.",
            "negatedDescription": null
        },
        {
            "name": "use-defaults",
            "description": "Use default values for options not configured explicitly",
            "negatedDescription": "Disables option --use-defaults."
        }
    ]
